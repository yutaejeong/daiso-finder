# 다이소 외부 API 베이스 URL
NEXT_PUBLIC_API_URL=https://www.daisomall.co.kr/api

# 배포 도메인 (robots.txt sitemap URL, generateMetadata canonical 등에 사용)
NEXT_PUBLIC_APP_URL=https://www.daiso-finder.kr

# Google Analytics 4 측정 ID (GA4 콘솔 → 관리 → 데이터 스트림 → 측정 ID)
NEXT_PUBLIC_GA_ID=G-RK7N4R9G3G

# Chrome WebMCP Origin Trial 토큰 (배포 환경에서 document.modelContext 활성화)
WEBMCP_ORIGIN_TRIAL_TOKEN=

# 검색어를 쌓을 Apps Script 웹앱 주소 (docs/search-logs.md 참고, 비워두면 수집 꺼짐)
SEARCH_LOG_WEBHOOK_URL=

# 위 웹앱의 TOKEN 과 같은 값
SEARCH_LOG_WEBHOOK_TOKEN=

# Sentry 오류 수집 DSN (docs/sentry.md 참고, 비워두면 수집 꺼짐)
NEXT_PUBLIC_SENTRY_DSN=

# Sentry 환경 이름 (기본값: production / development)
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# 성능 트레이스 표본 비율 0~1 (기본값 0.1)
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# 소스맵 업로드용 (셋 다 있어야 업로드한다. 없으면 빌드는 그대로 성공)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Sentry 인스턴스 주소. 이 프로젝트 조직은 EU 리전이라 기본값이 https://de.sentry.io 다.
# 미국 리전으로 옮기면 https://sentry.io 로 바꾼다.
SENTRY_URL=
